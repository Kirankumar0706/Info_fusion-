# INFOFUSION ENVIRONMENT CONFIGURATION
# Connect to your Supabase project (PostgreSQL + Auth + Storage + RLS)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Note: InfoFusion features an integrated Offline / Demo Fallback Mode
# If Supabase keys are not set, the platform operates seamlessly using the 
# pre-seeded 3-minute hackathon evaluation dataset!
